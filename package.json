{
  "name": "footnotes",
  "private": true,
  "version": "0.1.0",
  "description": "Footnotes: adaptive music that helps people with Parkinson's walk more steadily. DurHack 2026.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,yellow \"npm run dev -w @footnotes/server\" \"npm run dev -w @footnotes/web\"",
    "dev:https": "concurrently -k -n server,web -c green,yellow \"npm run dev -w @footnotes/server\" \"npm run dev:https -w @footnotes/web\"",
    "build": "npm run build -w @footnotes/web",
    "start": "npm run start -w @footnotes/server",
    "demo": "npm run build && npm run start",
    "tunnel": "node scripts/tunnel.mjs 8787",
    "tunnel:dev": "node scripts/tunnel.mjs 5173",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test --workspaces --if-present",
    "fake-phone": "tsx scripts/fake-phone.ts",
    "analyze": "tsx scripts/analyze.ts",
    "daphnet": "tsx scripts/daphnet.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2"
  },
  "type": "module"
}
